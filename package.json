{
  "name": "ai-helper-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:next": "pnpm --filter @support-widget/example-next dev",
    "dev:vite": "pnpm --filter @support-widget/example-vite dev",
    "dev:html": "pnpm --filter @support-widget/example-plain-html dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @support-widget/ai-helper test",
    "test:watch": "pnpm --filter @support-widget/ai-helper test:watch",
    "size": "pnpm --filter @support-widget/ai-helper size",
    "e2e": "playwright test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
